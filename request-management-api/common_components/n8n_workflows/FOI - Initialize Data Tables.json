    {
      "parameters": {
        "jsCode": "const REQUIRED_TABLES = ['foi-process-audit', 'foi-payment-sla', 'foi-execution-errors'];\nconst existingNames = $input.all().map(item => String(item.json.name || '').trim().toLowerCase());\n\nreturn [{\n  json: {\n    auditTableExists: existingNames.includes('foi-process-audit'),\n    slaTableExists: existingNames.includes('foi-payment-sla'),\n    errorsTableExists: existingNames.includes('foi-execution-errors'),\n    existingTableNames: existingNames\n  }\n}];"
      },

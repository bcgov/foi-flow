      "typeVersion": 3.4,
      "position": [
        224,
        0
      ],
      "notes": "PLACEHOLDER retention periods. The FOI records owners must decide them (roadmap D1) before this workflow is activated. Rows older than the cutoff are deleted: nothing in the event flow depends on them (idempotency, ordering and error mapping live in the API outbox). Export the tables first if the old rows must be kept."
    },
    {
      "parameters": {
        "operation": "deleteRows",
        "dataTableId": {
          "__rl": true,
          "value": "RK0xzpLfp9c1oM87",
          "mode": "list",
          "cachedResultName": "foi-process-audit",
          "cachedResultUrl": "/projects/CeytGDNs0Ylp3zu1/datatables/RK0xzpLfp9c1oM87"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "createdAt",
              "condition": "lt",
              "keyValue": "={{ $json.auditCutoff }}"
            }
          ]
        },
        "options": {}
      },

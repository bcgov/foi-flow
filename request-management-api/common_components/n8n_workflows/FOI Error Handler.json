      "id": "abce2df1-e935-4cec-acc1-625b5943017e",
      "name": "Record Failure",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1712,
        384
      ],
      "onError": "continueRegularOutput",
      "notes": "One row per failed execution in foi-execution-errors (create it with FOI - Initialize Data Tables, then select it here). A failure to write must not stop the outbox update or the alert."
    },
    {
      "parameters": {
        "jsCode": "// Combine what n8n passes to an error workflow with the request ids recorded by FOI Request Routing.\nconst t = $('FOI Error Trigger').first().json;\nconst audit = $input.first()?.json ?? {};\nconst ex = t.execution ?? {};\nconst wf = t.workflow ?? {};\nconst str = (v) => (v === undefined || v === null || v === '' ? null : String(v));\n\n// Execution errors carry execution.*; a trigger that failed to start carries trigger.error instead.\nconst errorMessage = String(ex.error?.message ?? t.trigger?.error?.message ?? 'Unknown error').slice(0, 1500);\nconst failedNode = str(ex.lastNodeExecuted ?? ex.error?.node?.name);\nconst workflowName = str(wf.name) ?? 'unknown workflow';\n\n// event_id is only known for runs of FOI Request Routing that got as far as 'Audit: Event Received'.\n// Anything else (e.g. FOI Payment Expiry SLA Job, or a run that failed before that audit row) has none.\nconst eventId = str(audit.event_id);\n\nconst requestIds = [\n  audit.foi_request_id ? 'FOI request ' + audit.foi_request_id : null,\n  audit.ministry_request_id ? 'ministry request ' + audit.ministry_request_id : null,\n  audit.raw_request_id ? 'raw request ' + audit.raw_request_id : null,\n].filter(Boolean).join(', ');\n\nconst alertLines = [\n  'A FOI n8n workflow run failed.',\n  'Workflow: ' + workflowName,\n  'Failed step: ' + (failedNode ?? 'n/a'),\n  'Event: ' + (str(audit.event) ?? 'n/a') + (eventId ? ' (' + eventId + ')' : ''),\n  requestIds ? 'Request: ' + requestIds : null,\n  'Error: ' + errorMessage.slice(0, 500),\n  'Execution: ' + (str(ex.url) ?? str(ex.id) ?? 'n/a'),\n  eventId ? 'Outbox: marked FAILED, available for replay.' : 'Outbox: no event_id for this run, nothing to mark FAILED.',\n].filter(Boolean);\n\n// Params for the Notify MJML template. Notify rejects a missing key, so every key is always a string ('' when unknown).\nconst notifyParams = {\n  environment: 'DEV', // change per environment\n  failed_at: $now.setZone('America/Vancouver').toFormat('yyyy-LL-dd HH:mm ZZZZ'),\n  workflow_name: workflowName,\n  workflow_id: str(wf.id) ?? '',\n  failed_node: failedNode ?? '',\n  error_message: errorMessage,\n  execution_id: str(ex.id) ?? '',\n  execution_url: str(ex.url) ?? '',\n  event: str(audit.event) ?? '',\n  event_id: eventId ?? '',\n  foi_request_id: str(audit.foi_request_id) ?? '',\n  ministry_request_id: str(audit.ministry_request_id) ?? '',\n  raw_request_id: str(audit.raw_request_id) ?? '',\n};\n\nreturn [{\n  json: {\n    execution_id: str(ex.id),\n    execution_url: str(ex.url),\n    workflow_id: str(wf.id),\n    workflow_name: workflowName,\n    failed_node: failedNode,\n    error_message: errorMessage,\n    event_id: eventId,\n    event: str(audit.event),\n    raw_request_id: str(audit.raw_request_id),\n    foi_request_id: str(audit.foi_request_id),\n    ministry_request_id: str(audit.ministry_request_id),\n    status: str(audit.status),\n    outbox_error: (workflowName + (failedNode ? ' > ' + failedNode : '') + ': ' + errorMessage).slice(0, 1900),\n    alert_subject: 'FOI n8n workflow failed: ' + workflowName + (failedNode ? ' > ' + failedNode : ''),\n    notify_params: notifyParams,\n    alert_text: alertLines.join('\\n'),\n  },\n}];"
      },

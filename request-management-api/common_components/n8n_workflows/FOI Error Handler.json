      "id": "b2c3d4e5-0006-4b00-8000-000000000006",
      "name": "Lookup Event By Execution",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "alwaysOutputData": true,
      "retryOnFail": false,
      "position": [
        1264,
        384
      ],

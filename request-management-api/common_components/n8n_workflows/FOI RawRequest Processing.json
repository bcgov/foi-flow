      "id": "1c18b767-ec85-47f1-8325-6810d31721da",
      "name": "Route On Status",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [
        1360,
        464
      ],
      "notes": "Status is read from the original webhook payload and lower-cased so both `Open` and `open` route correctly."
    },
    {
      "parameters": {
        "jsCode": "try {\n  const data = $('Intake: Set Process Variables').first().json;\n  const event = data.event ?? null;\n  const eventId = data.eventId ?? null;\n  const occurredAt = data.occurredAt ?? null;\n  const foiRequestId = data.foiRequestId ?? null;\n  const rawRequestId = data.rawRequestId ?? null;\n  const status = data.status ?? null;\n  const ministries = data.ministries ?? null;\n  const assignedGroup = data.assignedGroup ?? null;\n  const assignedTo = data.assignedTo ?? null;\n  const metadata = data.metadata ?? null;\n\n  return [{\n    json: {\n      event: event,\n      eventId: eventId,\n      occurredAt: occurredAt,\n      foiRequestId: foiRequestId,\n      rawRequestId: rawRequestId,\n      status: status,\n      ministries: ministries,\n      assignedGroup: assignedGroup,\n      assignedTo: assignedTo,\n      metadata: metadata\n    }\n  }];\n\n} catch (error) {\n  return [{\n    json: {\n      error: true,\n      errorMessage: error.message\n    }\n  }];\n}"
      },

      "id": "0e25fb03-163d-4af5-a206-d4d9184ad9aa",
      "name": "Start",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        240,
        560
      ],
      "notes": "Fixed input fields for every fee / payment event. Started by FOI Request Routing (foi-fee-payment / foi-manage-payment), FOI IAO Complete Process (initiate / cancel), FOI IAO Correspondence Process (initiate) and FOI Payment Expiry SLA Job (expire). Fields a caller does not send stay empty."
    },
    {
      "parameters": {
        "jsCode": "// Normalises a fee / payment event so this workflow can be executed on its own.\n// Accepts: foi-fee-payment / foi-manage-payment items from FOI Request Routing (normalised fields +\n// `payload` + `metadata`), the snake_case inputs sent by the IAO sub-workflows (feeAction initiate/cancel),\n// and foi-payment-expired items from FOI Payment Expiry SLA Job.\n// Replaces the old Wait-based model: each outcome (PAID / CANCELLED / EXPIRED) is its own execution.\ntry {\n\nconst src = $input.first().json || {};\n\nconst parseJson = (value) => {\n  if (value && typeof value === 'object') return value;\n  if (typeof value === 'string' && value.trim()) {\n    try { return JSON.parse(value); } catch (e) {\n      try { return JSON.parse(value.replace(/'/g, '\"')); } catch (e2) { return {}; }\n    }\n  }\n  return {};\n};\nconst first = (...values) => {\n  for (const v of values) { if (v !== undefined && v !== null && v !== '') return v; }\n  return null;\n};\n// const str = (v) => (v === undefined || v === null ? '' : String(v));\nconst str = (v) =>\n  v === undefined || v === null\n    ? ''\n    : typeof v === 'object'\n      ? JSON.stringify(v)\n      : typeof v === 'string'\n        ? v\n        : String(v);\n\nconst bool = (v) => v === true || (typeof v === 'string' && v.trim().toLowerCase() === 'true');\n\nconst metadata = parseJson(src.metadata);\nconst foiRequestMetaData = parseJson(metadata?.foiRequestMetaData);\nconst event = str(src.event);\nconst eventId = str(src.eventId);\nconst occurredAt = str(src.occurredAt);\nconst status = str(first(src?.status, metadata?.status));\nconst category = str(src.category);\nconst paymentStatus = str(first(src.paymentStatus, metadata?.paymentstatus)).toUpperCase();\n\nlet feeAction = str(src.feeAction);\nif (!feeAction) {\n  if (event === 'foi-fee-payment' || category === 'foi-fee-payment') {\n    feeAction = 'initiate';\n  } else if (event === 'foi-payment-expired') {\n    feeAction = 'expire';\n  } else if (event === 'foi-manage-payment' || category === 'foi-manage-payment') {\n    feeAction = paymentStatus === 'PAID' ? 'paid' : (paymentStatus === 'CANCELLED' ? 'cancel' : (paymentStatus === 'EXPIRED' ? 'expire' : 'unsupported'));\n  } else {\n    feeAction = 'unsupported';\n  }\n}\n\nconst fileNumber = str(src.fileNumber);\nconst applicantCorrespondenceId = str(first(src.applicantCorrespondenceId, foiRequestMetaData?.applicantcorrespondenceid, metadata?.applicantCorrespondenceId));\nconst templateName = str(first(src.templateName, foiRequestMetaData?.templatename, metadata?.templateName));\nconst paymentExpiryDate = str(first(src.paymentExpiryDate, src?.slaPaymentExpiryDate, foiRequestMetaData?.paymentExpiryDate));\nconst paymentUrl = str(first(src?.paymentUrl, foiRequestMetaData?.paymenturl, ));\n\nreturn [{\n  json: {\n    event,\n    eventId,\n    occurredAt,\n    feeAction,\n    category,\n    applicantCorrespondenceId,\n    templateName,\n    paymentStatus: paymentStatus,\n    isOfflinePayment: bool(src.isOfflinePayment),\n    isSync: bool(src.isSync),\n    isPaymentActive: bool(src.isPaymentActive),\n    rawRequestId: str(first(src.rawRequestId,metadata?.rawRequestId)),\n    foiRequestId: str(src.foiRequestId),\n    ministryRequestId: str(src.ministryRequestId),\n    serviceKey: str(src?.serviceKey),\n    paymentExpiryDate,\n    paymentUrl,\n    status,\n    previousStatus: str(src.previousStatus),\n    nextStateName: str(foiRequestMetaData?.nextStateName),\n    fileNumber: fileNumber,\n    slaId: src.paymentSlaId,\n    saveDataPayload: str(src.saveDataPayload),\n    triggeredBy: str(first(src.triggeredBy, src?.event)),\n    metadata: str(metadata),\n    executionId: $execution.id\n  }\n}];\n  \n} catch (error) {\n  const src = $input.first().json || {};\n    return {\n      json: {\n        event: '',\n        eventId: (src && typeof src === 'object' && typeof src.eventId === 'string') ? src.eventId : null,\n        receivedEvent: (src && typeof src === 'object' && typeof src.event === 'string') ? src.event : null,\n        error: true,\n        errorMessage: error.message,\n        metadata: src.metadata ?? null,\n        executionId: $execution.id,\n      },\n    };\n}\n\n"
      },

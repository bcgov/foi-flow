    {
      "parameters": {
        "jsCode": "// Builds the fixed-field input for FOI Fee Processing (feeAction = initiate): every field the Start node of that workflow accepts.\ntry {\n  const parseJson = (value) => {\n    if (value && typeof value === 'object') return value;\n    if (typeof value === 'string' && value.trim()) {\n      try { return JSON.parse(value); } catch (e) {\n        try { return JSON.parse(value.replace(/'/g, '\"')); } catch (e2) { return {}; }\n      }\n    }\n    return {};\n  };\n  \n  const input = $('Set Event Variables').first().json || {};\n  const eventId = input.eventId;\n  const occurredAt = input.occurredAt;\n  const metadata = parseJson(input.metadata);\n  const foiRequestMetaData = parseJson(metadata?.foiRequestMetaData);\n    \n  return [{\n    json: {\n      event: 'foi-fee-payment',\n      eventId,\n      occurredAt,\n      feeAction: 'initiate',\n      triggeredBy: input.event,\n      category: 'foi-fee-payment',\n      serviceKey: 'correspondence',\n      paymentStatus: 'NOT PAID',\n      isSync: false,\n      isOfflinePayment: false,\n      isPaymentActive: false,\n      rawRequestId: String(input.rawRequestId ?? ''),\n      foiRequestId: String(input.foiRequestId ?? ''),\n      ministryRequestId: String(input.ministryRequestId ?? ''),\n      fileNumber: foiRequestMetaData?.id,\n      paymentExpiryDate: foiRequestMetaData?.paymentExpiryDate,\n      previousStatus: '',\n      status: input.status ?? foiRequestMetaData?.status ?? '',\n      applicantCorrespondenceId: foiRequestMetaData?.applicantcorrespondenceid ?? '',\n      templateName: foiRequestMetaData?.templatename ?? '',\n      executionId: input.executionId,\n      metadata: input.metadata\n    }\n  }];\n  \n} catch (error) {\n  const input = $('Set Event Variables').first().json || {};\n    return {\n      json: {\n        event: '',\n        receivedEvent: (input && typeof input === 'object' && typeof input.event === 'string') ? input.event : null,\n        error: true,\n        errorMessage: error.message,\n        metadata: input.metadata ?? null,\n        executionId: $execution.id,\n      },\n    };\n}"
      },

      "id": "7d7e469a-f522-4e81-921d-1ef407232867",
      "name": "Get Expired Payment SLAs",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        816,
        592
      ],
      "notes": "All ACTIVE payment-expiry rows. 'Apply BPMN Expiry Window' keeps only those due for an expiry notice today."
    },
    {
      "parameters": {
        "jsCode": "// Same rule as the Camunda foi-fee-processing daily timer:\n//   diffDays = floor(|now - paymentExpiryDate| / 1 day)\n//   expire when diffDays == 0 && expirycounter < 1\n// A payment expires only when the run is within 24 hours of its payment_expiry_date, before or after it.\n// Outside that window no notice is sent and the row stays ACTIVE, as the Camunda instance keeps waiting, so a\n// later payment or cancellation is still processed. A date whose window was missed is not caught up.\n// expirycounter < 1 (notify once): only ACTIVE rows are read, and FOI Fee Processing closes the row once it has\n// handled the expiry.\n// As in Camunda, a row without a usable payment_expiry_date never expires (expires_at is not used).\n// A date-only value such as 2026-11-25 is read as midnight UTC, as in Camunda.\nconst DAY_MS = 1000 * 60 * 60 * 24;\nconst now = new Date();\n\nreturn $input.all().filter((item) => {\n  const sentOn = String(item.json.payment_expiry_date ?? '').trim();\n  const diffDays = Math.floor(Math.abs(now - new Date(sentOn)) / DAY_MS); // NaN when there is no usable date\n  return diffDays === 0;\n});"
      },
      "id": "45694b4e-3d8e-4f83-8341-43152928dc34",
      "name": "Apply BPMN Expiry Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        592
      ]
    },
    {
      "parameters": {
        "jsCode": "// One independent foi-payment-expired event per expired payment SLA.\nconst parseJson = (value) => {\n  if (value && typeof value === 'object') return value;\n  if (typeof value === 'string' && value.trim()) {\n    try { return JSON.parse(value); } catch (e) {\n      try { return JSON.parse(value.replace(/'/g, '\"')); } catch (e2) { return {}; }\n    }\n  }\n  return {};\n};\n// Each row carries its own metadata: parse it per row (a single parse of $json.metadata would reuse the first row's\n// rawRequestId / status for every event). The row metadata stores foiRequestMetaData as a JSON string, so it is parsed twice.\nreturn $input.all().map((item) => {\n  const sla = item.json;\n  const metadata = parseJson(sla.metadata);\n  const foiRequestMetaData = parseJson(metadata?.foiRequestMetaData);\n  const payload = {\n    event: 'foi-payment-expired',\n    source: 'FOI Payment Expiry SLA Job',\n    slaId: sla.id,\n    rawRequestId: foiRequestMetaData?.rawRequestId ?? metadata?.rawRequestId,\n    foiRequestId: sla.foi_request_id,\n    ministryRequestId: sla.ministry_request_id,\n    fileNumber: sla.file_number,\n    status: foiRequestMetaData?.status ?? metadata?.status,\n    paymentExpiryDate: sla.payment_expiry_date,\n    expiresAt: sla.expires_at,\n    applicantCorrespondenceId: sla.applicant_correspondence_id,\n    templateName: sla.template_name,\n  };\n  return {\n    json: {\n      event: 'foi-payment-expired',\n      feeAction: 'expire',\n      category: 'foi-payment-expired',\n      paymentSlaId: sla.id,\n      foiRequestId: sla.foi_request_id,\n      ministryRequestId: sla.ministry_request_id,\n      fileNumber: sla.file_number,\n      serviceKey: sla.service_key,  \n      previousStatus: sla.prev_status,      \n      paymentExpiryDate: sla.payment_expiry_date,\n      paymentStatus: 'EXPIRED',\n      payload,\n      metadata: JSON.stringify(payload)\n    }\n  };\n});\n"
      },
      "id": "85e2307b-e5c4-4068-9e81-808555fbe7e1",
      "name": "Build Payment Expired Events",

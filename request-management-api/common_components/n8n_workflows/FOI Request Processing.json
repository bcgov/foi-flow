    {
      "parameters": {
        "jsCode": "try {\n  const event = $('Set Process Variables').item.json.event;\n  const eventId = $('Set Process Variables').item.json.eventId;\n  const occurredAt = $('Set Process Variables').item.json.occurredAt;  \n  const rawRequestId = $('Set Process Variables').item.json.rawRequestId;\n  const assignedTo = $('Set Process Variables').item.json.assignedTo;\n  const assignedGroup = $('Set Process Variables').item.json.assignedGroup;\n  const metadata = $('Set Process Variables').item.json.metadata;\n  const ministriesString = $('Set Process Variables').item.json.ministries;\n  const ministries =  ministriesString\n    ? JSON.parse(ministriesString)\n    : {};\n  return ministries.map(ministry => ({\n    json: {\n      event: event,\n      eventId: eventId,\n      occurredAt: occurredAt,\n      processType: 'ministry-request-process',\n      rawRequestId: rawRequestId,\n      foiRequestId: ministry.foirequestid,\n      ministryRequestId: ministry.id,\n      // fileNumber: ministry.filenumber,\n      status: \"Open\",    \n      assignedTo: assignedTo,\n      assignedGroup: assignedGroup,\n      // axisRequestId: ministry.axisrequestid,\n      assignedMinistryGroup: ministry?.assignedgroup,\n      metadata: metadata\n    }\n  }));\n\n} catch (error) {\n  return [{\n    json: {\n      error: true,\n      errorMessage: error.message\n    }\n  }];\n}"
      },

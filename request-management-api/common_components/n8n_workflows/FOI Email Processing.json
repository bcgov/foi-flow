      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Mirrors the Camunda \"apply settings\" listener in foi-email-processing.bpmn:\n// body = {templateName, applicantCorrespondenceId} for servicekey 'correspondence' or templates PAYOUTSTANDING/PAYONLINE, otherwise {}.\n// Inputs come from the trigger in camelCase (templateName, serviceKey, applicantCorrespondenceId).\nconst src = $json;\nconst str = (v) => (v === undefined || v === null) ? '' : String(v).trim();\n\nconst serviceKey = str(src.serviceKey).toLowerCase();\nconst templateName = str(src.templateName);\nconst templateUpper = templateName.toUpperCase();\n// API schema expects an integer; callers pass strings ('' when not set)\nconst rawCorrId = str(src.applicantCorrespondenceId);\nconst applicantCorrespondenceId = /^\\d+$/.test(rawCorrId) ? parseInt(rawCorrId, 10) : null;\n\nlet saveDataPayload = {};\nif (\n  serviceKey === 'correspondence' ||\n  templateUpper === 'PAYOUTSTANDING' ||\n  templateUpper === 'PAYONLINE'\n) {\n  saveDataPayload = {\n    templateName: templateName || null,\n    applicantCorrespondenceId: applicantCorrespondenceId\n  };\n}\n\nreturn { json: { ...src, saveDataPayload: JSON.stringify(saveDataPayload) } };"
      },

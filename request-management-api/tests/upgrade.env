# Synthetic configuration for the isolated python-upgrade Compose project only.
FLASK_ENV=testing
PYTHON_DOTENV_DISABLED=1
DATABASE_TEST_URL=postgresql://postgres:upgrade-test-only@postgres:5432/foi_upgrade_test
DATABASE_TEST_HOST=postgres
DATABASE_TEST_NAME=foi_upgrade_test
DATABASE_TEST_USERNAME=postgres
DATABASE_TEST_PASSWORD=upgrade-test-only
DATABASE_HOST=postgres
DATABASE_NAME=foi_upgrade_test
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=upgrade-test-only
DATABASE_PORT=5432
REDIS_URL=redis://redis:6379/0
CACHE_REDISURL=redis://redis:6379/1
CACHE_TIMEOUT=300
CACHE_ENABLED=N
SOCKETIO_REDIS_HOST=redis
PUBLICATION_REDIS_HOST=redis
EVENT_QUEUE_HOST=redis
EVENT_QUEUE_PORT=6379
S3_ENDPOINT_URL=https://storage:8333
REQUESTS_CA_BUNDLE=/test-tls/storage.crt
OSS_S3_ENVIRONMENT=upgrade
OSS_S3_HOST=storage:8333
OSS_S3_REGION=ca-central-1
OSS_S3_SERVICE=s3
OSS_S3_FORMS_BUCKET=upgrade-forms-foirequests
OSS_S3_FORMS_ACCESS_KEY_ID=upgrade-test-only
OSS_S3_FORMS_SECRET_ACCESS_KEY=upgrade-test-only
JWT_OIDC_ISSUER=http://oidc:8080/realms/test
JWT_OIDC_JWKS_URI=http://oidc:8080/realms/test/certs
JWT_OIDC_WELL_KNOWN_CONFIG=http://oidc:8080/realms/test/.well-known/openid-configuration
JWT_OIDC_ALGORITHMS=RS256
JWT_OIDC_AUDIENCE=foi-upgrade-test
KEYCLOAK_ADMIN_HOST=http://oidc:8080
KEYCLOAK_ADMIN_REALM=test
KEYCLOAK_ADMIN_CLIENT_ID=foi-upgrade-test
KEYCLOAK_ADMIN_CLIENT_SECRET=upgrade-test-only
BPM_ENGINE_REST_URL=http://workflow:8080/engine-rest
BPM_TOKEN_URL=http://oidc:8080/auth/realms/test/protocol/openid-connect/token
BPM_CLIENT_ID=foi-upgrade-test
BPM_CLIENT_SECRET=upgrade-test-only
TEST_INTAKE_USERID=upgrade-intake
TEST_INTAKE_PASSWORD=upgrade-test-only
TEST_MINISTRY_USERID=upgrade-ministry
TEST_MINISTRY_PASSWORD=upgrade-test-only
SOCKETIO_LOG_ENABLED=false
CORS_ORIGIN=http://localhost
PUBLICATION_COMPLETED_CONSUMER_ENABLED=false
PUBLICATION_PREPUBLISHING_SCHEDULER_ENABLED=false
SOCKETIO_MESSAGE_QTYPE=INMEMORY
FOI_REQUESTQUEUE_REDISHOST=redis
FOI_REQUESTQUEUE_REDISPORT=6379
FOI_REQUESTQUEUE_REDISPASSWORD=
FOI_REQUESTQUEUE_REDISCHANNEL=upgrade-notifications
AWS_ACCESS_KEY_ID=upgrade-test-only
AWS_SECRET_ACCESS_KEY=upgrade-test-only
AWS_DEFAULT_REGION=ca-central-1
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
PORT=5000
